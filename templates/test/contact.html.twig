{% extends 'base.html.twig' %}

{% block title %}Hello TestController!{% endblock %}

{% block body %}
<body id="hasard">


<h1>{{ h1 }}</h1>


<div {{ stimulus_controller('hello') }}>
   dans twig
</div>

<div data-controller="toggle">
    <button data-action="click->toggle#affiche" class="bg-blue-500 text-white px-4 py-2">
        Afficher / Masquer
    </button>

    <div data-toggle-target="content" class="hidden mt-4">
        <input data-action="click->toggle#color" style="border: solid 3px black;" type="button" id="monBoutton" value="Aléatoire">    
    </div>
</div>
    {{ form_start(form, {'attr': {'class': 'space-y-4'}}) }}
    
    {{ form_widget(form) }}    
    <button type="submit" class="w-full bg-blue-500 hover:bg-blue-600 text-white py-2 px-4 rounded">
        Envoyer
    </button>    
    {{ form_end(form) }}
    {{dump(form)}}
</body>

{% endblock %}
