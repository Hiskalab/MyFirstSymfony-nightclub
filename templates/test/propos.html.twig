{% extends 'base.html.twig' %}

{% block title %}Hello TestController!{% endblock %}

{% block body %}


<h1>{{ h1 }}</h1>

<ul>
{% for item in navigation %}
    <li><a href="{{ item.href }}">{{ item.caption }}</a></li>
{% endfor %}
</ul>

<ul>
{% for dj in djs %}
  <li>{{ dj.name }}</li>
{% else %}
  <li>Aucun DJ prévu</li>
{% endfor %}
</ul>




{% endblock %}
